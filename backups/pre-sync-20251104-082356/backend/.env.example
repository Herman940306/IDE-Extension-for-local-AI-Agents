# AuraIA Multi-Model Architecture v2.1
# Project Creator: Herman Swanepoel
# Enhanced with 10-Model Intelligent Routing System

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ChromaDB Configuration
CHROMA_PERSIST_DIR=./data/chroma_db

# FAISS Configuration
FAISS_INDEX_PATH=./data/faiss_index

# LoRA Adapters
LORA_ADAPTERS_PATH=./data/lora_adapters

# Provenance & Logging
PROVENANCE_DB_PATH=./data/provenance.db
COGNITIVE_TRACE_PATH=./data/trace_logs.jsonl

# ═══════════════════════════════════════════════════════════════════
# 🤖 MULTI-MODEL ARCHITECTURE - Intelligent Task-Based Routing
# ═══════════════════════════════════════════════════════════════════

# 🧠 System 1 (Fast Reasoner) - Primary Intelligence
# Role: Top-tier reasoning & coding speed, modern tokenization, multilingual
SYSTEM1_MODEL=qwen3:8b
SYSTEM1_KEEP_ALIVE=30m
SYSTEM1_FORCE_CPU=false
SYSTEM1_TIMEOUT=30.0

# ⚙️ Task Router - Light Classification
# Role: Fast logic classifier, decides which model to invoke
ROUTER_MODEL=qwen3:4b
ROUTER_KEEP_ALIVE=15m
ROUTER_FORCE_CPU=false
ROUTER_TIMEOUT=15.0

# 💻 Code Engine - Specialized Code Generation
# Role: Reliable code generation & language bindings, stable token handling
CODE_ENGINE_MODEL=codellama:7b
CODE_ENGINE_KEEP_ALIVE=20m
CODE_ENGINE_FORCE_CPU=false
CODE_ENGINE_TIMEOUT=45.0

# 🧩 System 2 (Deep Verifier) - Analytical Validation
# Role: Logic validation, error tracing, high math and code QA ability
SYSTEM2_MODEL=deepseek-r1:8b
SYSTEM2_KEEP_ALIVE=10m
SYSTEM2_FORCE_CPU=false
SYSTEM2_TIMEOUT=60.0

# 🧩 Fallback Reasoner - CPU-Safe Deep Reasoning
# Role: Deep reasoning when GPUs saturated, CPU-safe fallback
FALLBACK_MODEL=codellama:13b-instruct-q4_0
FALLBACK_KEEP_ALIVE=0
FALLBACK_FORCE_CPU=true
FALLBACK_TIMEOUT=90.0

# 💬 UX Premium - High-Quality Conversational
# Role: Premium-quality tone and phrasing, gives agent warmth and humanity
UX_PREMIUM_MODEL=gemma3:12b
UX_PREMIUM_KEEP_ALIVE=10m
UX_PREMIUM_FORCE_CPU=false
UX_PREMIUM_TIMEOUT=40.0

# 💬 UX Light - Quick Help (Low-power)
# Role: Quick help prompts and doc explanations, CPU-friendly
UX_LIGHT_MODEL=gemma3:4b
UX_LIGHT_KEEP_ALIVE=15m
UX_LIGHT_FORCE_CPU=true
UX_LIGHT_TIMEOUT=20.0

# 🔍 Embeddings - Context Memory & Search
# Role: Excellent embeddings for semantic search, lightweight
EMBEDDINGS_MODEL=nomic-embed-text
EMBEDDINGS_KEEP_ALIVE=30m
EMBEDDINGS_FORCE_CPU=true
EMBEDDINGS_TIMEOUT=10.0

# 🛡 Safety Layer - Content Moderation
# Role: Reliable open moderation for code and NL responses
SAFETY_MODEL=phi3:mini
SAFETY_KEEP_ALIVE=-1
SAFETY_FORCE_CPU=true
SAFETY_TIMEOUT=15.0
ENABLE_SAFETY_CHECK=false

# 🧠 Legacy Fallback - Emergency Only
# Role: Emergency local fallback for resource-limited scenarios
LEGACY_MODEL=llama3.2:3b
LEGACY_KEEP_ALIVE=5m
LEGACY_FORCE_CPU=true
LEGACY_TIMEOUT=20.0

# ═══════════════════════════════════════════════════════════════════
# LEGACY MODEL CONFIGURATION (For backwards compatibility)
# ═══════════════════════════════════════════════════════════════════

# These are kept for compatibility with older configurations
REASONER_MODEL=qwen3:8b
VERIFIER_MODEL=deepseek-r1:8b
ADVANCED_MODEL=codellama:13b-instruct-q4_0
CONVERSATIONAL_MODEL=gemma3:12b
SUMMARIZER_MODEL=phi3:mini
EMBEDDINGS_PROVIDER=sentence-transformers
EMBEDDINGS_OLLAMA_URL=http://localhost:11434
EMBEDDINGS_OLLAMA_MODEL_NAME=nomic-embed-text

# Preferred Ollama embedding model used by the app when Ollama provider is enabled
PREFERRED_OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Performance Tuning
OMP_NUM_THREADS=7
FLASH_ATTENTION_ENABLED=true

# Ollama request policy
REASONER_TIMEOUT_SECONDS=30
VERIFIER_TIMEOUT_SECONDS=60
OLLAMA_MAX_RETRIES=2
OLLAMA_RETRY_BACKOFF_SECONDS=1.0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ENCRYPTION_KEY=your-encryption-key-here-change-in-production

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/aura_ia.log

# Feature Flags
ENABLE_COGNITIVE_TRACES=true
ENABLE_PREDICTIVE_CACHING=true
ENABLE_CONTINUAL_LEARNING=false
