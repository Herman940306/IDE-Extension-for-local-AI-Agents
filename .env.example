# Top-level Compose environment variables
# Copy to .env and customize for your environment

# Caddy / TLS
SERVER_DOMAIN=localhost
ACME_EMAIL=you@example.com

# Grafana alerting
# Replace with your real webhook (Slack/Discord/custom)
GRAFANA_ALERT_WEBHOOK_URL=https://example.invalid/webhook

# Email alerts (Grafana SMTP)
# Set your alert destination email (can be your own email)
GRAFANA_ALERT_EMAIL=alerts@example.com

# SMTP settings (example shows Gmail; for Gmail you must use an App Password with 2FA enabled)
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER=your_email@gmail.com
GF_SMTP_PASSWORD=your_app_password_here
GF_SMTP_FROM_ADDRESS=alerts@yourdomain.com
GF_SMTP_FROM_NAME=Aura Alerts

# Grafana admin (rotate regularly; do not commit real secrets)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# Prometheus retention (e.g., 15d, 30d)
PROMETHEUS_RETENTION=15d

# Embeddings Provider (Backend)
# Default: sentence-transformers. To use Ollama embeddings, set provider to 'ollama'.
EMBEDDINGS_PROVIDER=sentence-transformers
EMBEDDINGS_OLLAMA_URL=http://localhost:11434
EMBEDDINGS_OLLAMA_MODEL_NAME=nomic-embed-text
