{
    "pythonVersion": "3.11",
    "venvPath": ".",
    "venv": ".venv",
    "include": [
        "backend/src",
        "backend/tests"
    ],
    "exclude": [
        "**/__pycache__",
        "**/.venv",
        "**/node_modules"
    ],
    "reportMissingTypeStubs": false,
    "typeCheckingMode": "standard"
}