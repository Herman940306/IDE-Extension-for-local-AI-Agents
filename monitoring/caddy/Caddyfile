{
	# Use your email for Let's Encrypt/ACME notifications
	email {$ACME_EMAIL}
}

# Use SERVER_DOMAIN if set, else default to localhost

{$SERVER_DOMAIN:localhost} {
	# Prometheus metrics via caddy-prometheus plugin disabled (plugin not available in base image)
	# If you need Caddy metrics, enable a custom build and re-add the block below.
	# prometheus {
	#     address :9180
	#     path /metrics
	# }

	encode zstd gzip

	# Access logging (rotated files)
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}

	# Security headers (safe defaults)
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}

	# --- API: strip /api prefix so FastAPI sees original paths
	handle_path /api/* {
		reverse_proxy backend:8001
	}

	# --- Multi-agent backends: strip prefix so FastAPI sees original paths
	handle_path /agent-1/* {
		reverse_proxy backend:8001
	}

	handle_path /agent-2/* {
		reverse_proxy backend_agent_2:8001
	}

	handle_path /agent-3/* {
		reverse_proxy backend_agent_3:8001
	}

	# --- Grafana: keep /grafana prefix (Grafana is configured to serve from subpath)
	handle /grafana/* {
		reverse_proxy grafana:3000
	}

	# --- Prometheus: keep /prometheus prefix; Prometheus is started with route-prefix
	handle /prometheus/* {
		reverse_proxy prometheus:9090
	}

	# Default: route everything else to the frontend (nginx serving built assets)
	handle {
		reverse_proxy frontend:80
	}
}
