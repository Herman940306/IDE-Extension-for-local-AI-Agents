# ============================================
# AuraIA Production Environment (Key Vault-backed)
# ============================================

# Azure Active Directory identity used to resolve Key Vault secrets
AZURE_TENANT_ID=<your-tenant-id>
AZURE_CLIENT_ID=<managed-identity-or-app-registration-id>
AZURE_CLIENT_SECRET=<optional-client-secret-if-not-using-managed-identity>

# Primary Key Vault endpoint that stores application secrets
AZURE_KEY_VAULT_NAME=<your-key-vault-name>
AZURE_KEY_VAULT_URI=https://<your-key-vault-name>.vault.azure.net/

# Secrets resolved at runtime via Azure Key Vault references
# Replace <your-key-vault-name> with the actual vault identifier.
SECRET_KEY=@Microsoft.KeyVault(SecretUri=https://<your-key-vault-name>.vault.azure.net/secrets/SECRET_KEY/)
ENCRYPTION_KEY=@Microsoft.KeyVault(SecretUri=https://<your-key-vault-name>.vault.azure.net/secrets/ENCRYPTION_KEY/)
OPENAI_API_KEY=@Microsoft.KeyVault(SecretUri=https://<your-key-vault-name>.vault.azure.net/secrets/OPENAI_API_KEY/)
ANTHROPIC_API_KEY=@Microsoft.KeyVault(SecretUri=https://<your-key-vault-name>.vault.azure.net/secrets/ANTHROPIC_API_KEY/)

# LLM configuration defaults; provider is keyed to cloud usage in production.
LLM_PROVIDER=openai
LLM_ALLOW_CLOUD=true
LLM_DEFAULT_MODEL=gpt-4o-mini

# Redis connection string for production cache and rate limiting
DB_REDIS_URL=redis://<redis-username>:<redis-password>@<redis-host>:6379/0

# Observability storage paths should live on durable, encrypted volumes
OBS_TRACE_LOG_PATH=/var/log/auraia/trace_logs.jsonl
OBS_PROVENANCE_DB_PATH=/var/lib/auraia/provenance.db

# Predictive cache tuning
PREDICTIVE_CACHE_ENABLED=true
PREDICTIVE_CACHE_PREDICTION_THRESHOLD=0.7

# Operation mode defaults to hybrid (cloud + local)
MODE_DEFAULT_MODE=hybrid

# FastAPI runtime parameters
API_HOST=0.0.0.0
API_PORT=8001
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=["https://portal.example.com","https://admin.example.com"]
