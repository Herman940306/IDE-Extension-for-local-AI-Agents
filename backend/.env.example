# AuraIA Next-Gen v2.0 Environment Configuration
# Project Creator: Herman Swanepoel

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ChromaDB Configuration
CHROMA_PERSIST_DIR=./data/chroma_db

# FAISS Configuration
FAISS_INDEX_PATH=./data/faiss_index

# LoRA Adapters
LORA_ADAPTERS_PATH=./data/lora_adapters

# Provenance & Logging
PROVENANCE_DB_PATH=./data/provenance.db
COGNITIVE_TRACE_PATH=./data/trace_logs.jsonl

# Model Configuration
REASONER_MODEL=llama3.2:3b
VERIFIER_MODEL=mistral:7b
SUMMARIZER_MODEL=phi3:mini

# Model Residency & Device Hints (1080 Ti profile)
# Keep System 1 hot, System 2 on-demand, Advanced on CPU-only and unloaded immediately
REASONER_KEEP_ALIVE=30m
VERIFIER_KEEP_ALIVE=10m
ADVANCED_MODEL=codellama:13b-instruct-q4_0
ADVANCED_FORCE_CPU=true
ADVANCED_KEEP_ALIVE=0

# Conversational UX model (chat/explain flows)
CONVERSATIONAL_MODEL=gemma2:9b
CONVERSATIONAL_KEEP_ALIVE=0

# Summarizer & Safety models (CPU-friendly)
SUMMARIZER_FORCE_CPU=true
SUMMARIZER_KEEP_ALIVE=5m
SAFETY_MODEL=phi3:medium
SAFETY_FORCE_CPU=true
SAFETY_KEEP_ALIVE=-1
ENABLE_SAFETY_CHECK=false

# Embeddings (optional Ollama backend)
# Default remains Sentence-Transformers. To switch to Ollama embeddings set provider and model.
EMBEDDINGS_PROVIDER=sentence-transformers
EMBEDDINGS_OLLAMA_URL=http://localhost:11434
EMBEDDINGS_OLLAMA_MODEL_NAME=nomic-embed-text

# Preferred Ollama embedding model used by the app when Ollama provider is enabled
PREFERRED_OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Performance Tuning
OMP_NUM_THREADS=7
FLASH_ATTENTION_ENABLED=true

# Ollama request policy
REASONER_TIMEOUT_SECONDS=30
VERIFIER_TIMEOUT_SECONDS=60
OLLAMA_MAX_RETRIES=2
OLLAMA_RETRY_BACKOFF_SECONDS=1.0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ENCRYPTION_KEY=your-encryption-key-here-change-in-production

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/aura_ia.log

# Feature Flags
ENABLE_COGNITIVE_TRACES=true
ENABLE_PREDICTIVE_CACHING=true
ENABLE_CONTINUAL_LEARNING=false
