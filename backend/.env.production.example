# === Environment Variables Template ===
# Copy this file to `.env.production` and fill in actual secret values.
# Do NOT commit `.env.production` — it contains sensitive data.

# Flask / FastAPI secret key (256-bit hex)
SECRET_KEY=<replace_with_secure_key>

# Encryption key (256-bit hex)
ENCRYPTION_KEY=<replace_with_secure_key>

# Redis connection URL
REDIS_URL=redis://redis:6379/0

# Prometheus configuration
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# Application environment
ENV=production
DEBUG=0
