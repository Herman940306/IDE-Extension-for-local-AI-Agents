{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "out",
    "lib": [
      "ES2020"
    ],
    "types": [
      "node",
      "vscode",
      "mocha"
    ],
    "typeRoots": [
      "./src/types",
      "./node_modules/@types"
    ],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true
  },
  "exclude": [
    "node_modules",
    ".vscode-test",
    "src/test",
    "test-js"
  ]
}
