{
  "name": "aura-ai-assistant",
  "displayName": "Aura AI Assistant",
  "description": "Enterprise AI Agents for VS Code",
  "version": "1.0.0",
  "publisher": "herman-swanepoel",
  "icon": "images/AuraIA_logo.jpg",
  "repository": {
    "type": "git",
    "url": "https://github.com/Herman940306/IDE-Extension-for-local-AI-Agents"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aura.generateCode",
        "title": "Aura: Generate Code"
      },
      {
        "command": "aura.refactorCode",
        "title": "Aura: Refactor Code"
      },
      {
        "command": "aura.explainCode",
        "title": "Aura: Explain Code"
      },
      {
        "command": "aura.fixBugs",
        "title": "Aura: Fix Bugs"
      },
      {
        "command": "enterpriseAI.toggleTelemetry",
        "title": "Aura: Toggle Telemetry"
      },
      {
        "command": "aura.rankGithubRepos",
        "title": "Aura: Rank GitHub Repos"
      },
      {
        "command": "aura.rankGithubAll",
        "title": "Aura: Rank GitHub Repos + Issues/PRs"
      },
      {
        "command": "aura.openGithubRankingView",
        "title": "Aura: Open GitHub Ranking View"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "auraGithubRanking",
          "name": "Aura: GitHub Ranking"
        }
      ]
    },
    "configuration": {
      "title": "Aura AI",
      "properties": {
        "aura.backend.url": {
          "type": "string",
          "default": "http://127.0.0.1:8001",
          "description": "Backend API URL"
        },
        "aura.backend.websocket": {
          "type": "string",
          "default": "ws://127.0.0.1:8001/ws",
          "description": "Backend WebSocket URL"
        },
        "aura.ranking.defaultQuery": {
          "type": "string",
          "default": "bug fix performance",
          "description": "Default query used when ranking if none provided"
        },
        "aura.ranking.itemsPerRepo": {
          "type": "number",
          "default": 20,
          "description": "Items per repo to fetch for aggregate ranking"
        },
        "aura.ranking.sinceDays": {
          "type": "number",
          "default": 30,
          "description": "Only include issues/PRs updated within the last N days"
        },
        "aura.ranking.ultraMode": {
          "type": "string",
          "enum": [
            "disabled",
            "mock",
            "local",
            "backend"
          ],
          "default": "local",
          "description": "Semantic mode for ranking: disabled=heuristic, mock=word overlap, local=cosine-like local, backend=try server ULTRA"
        },
        "enterpriseAI.privacy.allowTelemetry": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Allow Aura AI Assistant to collect anonymous productivity telemetry. Disabled by default for privacy-first operation."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "mocha -r ts-node/register src/test/**/*.test.ts",
    "lint": "echo (no linter configured)",
    "package": "npm run compile && vsce package",
    "package:publish": "npm run compile && vsce publish"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.80.0",
    "@types/ws": "^8.5.0",
    "@types/mocha": "^10.0.0",
    "mocha": "^10.2.0",
    "ts-node": "^10.9.2",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "ws": "^8.14.0"
  },
  "galleryBanner": {
    "color": "#0b1320",
    "theme": "dark"
  }
}