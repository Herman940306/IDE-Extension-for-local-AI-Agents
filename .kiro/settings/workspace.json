{
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance"
    ],
    "unwantedRecommendations": [
      "rust-lang.rust-analyzer"
    ]
  },
  "files": {
    "exclude": {
      "**/__pycache__": true,
      "**/*.pyc": true,
      "**/.pytest_cache": true,
      "**/node_modules": true,
      "**/.venv": true,
      "**/venv": true,
      "**/.git": true
    },
    "watcherExclude": {
      "**/__pycache__/**": true,
      "**/node_modules/**": true,
      "**/.venv/**": true,
      "**/venv/**": true,
      "**/.git/objects/**": true,
      "**/.git/subtree-cache/**": true,
      "**/models/**": true
    }
  },
  "search": {
    "exclude": {
      "**/__pycache__": true,
      "**/node_modules": true,
      "**/.venv": true,
      "**/venv": true,
      "**/models": true,
      "**/.git": true
    }
  },
  "python": {
    "analysis": {
      "exclude": [
        "**/__pycache__",
        "**/.pytest_cache",
        "**/node_modules",
        "**/.venv",
        "**/venv"
      ]
    }
  },
  "kiro": {
    "autonomyMode": "autopilot",
    "autoApprove": {
      "fileOperations": true,
      "shellCommands": true,
      "diagnostics": true,
      "mcpTools": true,
      "allOperations": true
    },
    "steering": {
      "alwaysInclude": [
        "OMNIDEVGOD.md",
        "00_Unified_Master_Agent.md",
        "git-workflow.md",
        "dependency-management.md"
      ],
      "enforcementLevel": "mandatory"
    },
    "commandTrust": {
      "enabled": true,
      "trustLevels": {
        "low": {
          "autoExecute": true,
          "requireConfirmation": false,
          "examples": [
            "read files",
            "search code",
            "analyze structure",
            "check diagnostics",
            "list directories"
          ]
        },
        "medium": {
          "autoExecute": true,
          "requireConfirmation": false,
          "examples": [
            "create/modify files",
            "install packages",
            "run tests",
            "commit changes",
            "refactor code"
          ]
        },
        "high": {
          "autoExecute": true,
          "requireConfirmation": false,
          "examples": [
            "delete databases",
            "deploy to production",
            "modify infrastructure",
            "change security settings",
            "system-wide changes",
            "batch operations"
          ]
        }
      }
    },
    "agent": {
      "mode": "fully-autonomous",
      "batchExecution": true,
      "autoCommit": true,
      "autoTest": true,
      "autoFix": true,
      "stopOnError": false,
      "continueOnFailure": true,
      "maxConsecutiveTasks": 50,
      "requireUserApproval": false
    }
  }
}