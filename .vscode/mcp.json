{
  "inputs": [
    {
      "type": "promptString",
      "id": "github_token",
      "description": "GitHub Personal Access Token",
      "password": true
    }
  ],
  "servers": {
    "github": {
      // Default GitHub MCP (Node-based, no Docker required). For Docker image, see commented block below.
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_TOKEN": "${input:github_token}"
      }
    },
    // "github-docker": {
    //   // Docker-based GitHub MCP server (requires Docker Desktop).
    //   "command": "docker",
    //   "args": [
    //     "run", "-i", "--rm",
    //     "-e", "GITHUB_PERSONAL_ACCESS_TOKEN",
    //     "-e", "GITHUB_TOKEN",
    //     "ghcr.io/github/github-mcp-server"
    //   ],
    //   "env": {
    //     "GITHUB_PERSONAL_ACCESS_TOKEN": "${input:github_token}",
    //     "GITHUB_TOKEN": "${input:github_token}"
    //   }
    // },
    "ide-agents": {
      // Command (stdio): run local Python MCP server
      "command": "${workspaceFolder}\\.venv-2\\Scripts\\python.exe",
      "args": [
        "${workspaceFolder}\\mcp_server\\ide_agents_mcp_server.py"
      ],
      "env": {
        // Optional overrides (defaults are fine if unset)
        // "IDE_AGENTS_BACKEND_URL": "http://127.0.0.1:8001",
        // "IDE_AGENTS_REQUEST_TIMEOUT": "30",
        "IDE_AGENTS_ULTRA_ENABLED": "1",
        "IDE_AGENTS_ULTRA_CONFIG": "${workspaceFolder}\\mcp_server\\ide_ultra_config.json",
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  }
}
