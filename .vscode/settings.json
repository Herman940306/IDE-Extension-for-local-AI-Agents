{
  "editor.tabCompletion": "on",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
    "source.fixAll": "explicit"
  },
  "diffEditor.codeLens": true,
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/bin/python",
  "python.pythonPath": "${workspaceFolder}/backend/.venv/bin/python",
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "black-formatter.args": ["--line-length=100"],
  "black-formatter.showNotification": "onWarning",

  // Flake8 - enabled with auto-fix on save
  "flake8.args": ["--max-line-length=100", "--extend-ignore=E203,W503"],
  "flake8.severity": {
    "E": "Warning",
    "F": "Error",
    "W": "Information"
  },
  "flake8.importStrategy": "fromEnvironment",

  // Enable Pylance type checking
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingImports": "warning",
    "reportMissingTypeStubs": "none",
    "reportUnusedImport": "information",
    "reportUnusedVariable": "warning",
    "reportGeneralTypeIssues": "warning"
  },

  // Mypy Type Checker (ms-python.mypy-type-checker) - NEW EXTENSION
  "mypy-type-checker.args": [
    "--config-file=${workspaceFolder}/mypy.ini",
    "--no-sqlite-cache",
    "--cache-dir=.mypy_cache_vscode",
    "--pretty"
  ],
  "mypy-type-checker.severity": {
    "error": "Error",
    "note": "Information"
  },
  "mypy-type-checker.importStrategy": "fromEnvironment",

  // Legacy Mypy extension (matangover.mypy) - FALLBACK
  "mypy.runUsingActiveInterpreter": true,
  "mypy.configFile": "mypy.ini",
  "mypy.targets": ["backend/src"],
  "mypy.args": [
    "--no-sqlite-cache",
    "--cache-dir=.mypy_cache_vscode",
    "--hide-error-codes",
    "--pretty"
  ],
  "mypy.showLiveErrors": true,
  "python.testing.pytestArgs": ["backend/tests", "-v"],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  "python.testing.autoTestDiscoverOnSaveEnabled": false,
  "python.terminal.useEnvFile": true,
  "errorLens.enabled": true,
  "errorLens.enabledDiagnosticLevels": ["error", "warning"],
  "errorLens.followCursor": "activeLine",
  "errorLens.gutterIconsEnabled": true,
  "yaml.schemas": {
    "https://json.schemastore.org/github-workflow.json": ".github/workflows/*.yml"
  },
  "yaml.format.enable": true,
  "yaml.validate": true,
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
    "editor.formatOnSave": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
    "editor.formatOnSave": true
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/node_modules": true,
    "**/.git": false
  },
  "search.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/node_modules": true
  },
  "workbench.sideBar.location": "left",
  "workbench.sideBar.visible": true,
  "workbench.panel.defaultLocation": "bottom",
  "workbench.activityBar.location": "default",
  "workbench.layoutControl.enabled": true,
  "workbench.editor.showTabs": "multiple",
  "terminal.integrated.defaultLocation": "panel",
  "terminal.integrated.enableFocusReport": false,
  "aiAgent.omnidevgod": {
    "mode": "HYPERDRIVE",
    "status": "FULLY_ACTIVATED",
    "intelligence": "MAXIMUM",
    "automation": "AGGRESSIVE",
    "quality": "ZERO_TOLERANCE",
    "communication": {
      "briefingMode": "CONCISE_REALTIME",
      "format": "ACTION_ORIENTED",
      "frequency": "EVERY_OPERATION",
      "style": "1-2 sentences max per action, focus on WHAT + WHY"
    }
  },
  "aiAgent.systemPrompts": {
    "priority": "CRITICAL_OVERRIDE",
    "adherence": "ABSOLUTE_MANDATORY",
    "executionMode": "PARALLEL_HYPERDRIVE",
    "master": {
      "description": "Master architectural and behavioral guidelines",
      "files": [
        ".kiro/steering/OMNIDEVGOD.md",
        ".kiro/steering/UNIFIED_MASTER_FRAMEWORK_v3.md",
        ".kiro/steering/git-workflow.md"
      ],
      "enforcement": "ALWAYS_ACTIVE",
      "priority": 1
    },
    "hooks": {
      "description": "Execution hooks - ALL ENABLED IN HYPERDRIVE",
      "files": [
        ".kiro/hooks/00-unified-master-hook.kiro.hook",
        ".kiro/hooks/aura-dev-master-godmode.kiro.hook",
        ".kiro/hooks/enterprise-quality-checks.kiro.hook",
        ".kiro/hooks/hook-config-manager.kiro.hook"
      ],
      "enforcement": "REALTIME_CONTINUOUS",
      "triggers": ["on-save", "on-type", "on-change", "on-focus", "on-lint"],
      "allHooksEnabled": true,
      "priority": 2
    },
    "documentation": {
      "description": "Supporting documentation - ACTIVE REFERENCE",
      "files": [
        ".kiro/hooks/unified-quality-gate.md",
        ".kiro/hooks/HOOKS_MIGRATION_GUIDE.md",
        ".kiro/hooks/INNOVATION_FEATURES.md"
      ],
      "enforcement": "CONTINUOUS_INTEGRATION",
      "priority": 3
    }
  },
  "github.copilot.advanced": {
    "inlineSuggestCount": 5,
    "debug.overrideEngine": "gpt-4-turbo",
    "customInstructions": "⚡ OMNIDEVGOD HYPERDRIVE ACTIVATED ⚡\\n\\nYou are AURA-DEV operating in GODMODE HYPERDRIVE..."
  },
  "project.metadata": {
    "projectName": "AuraIA - Enterprise AI Agents Integration System",
    "owner": "Herman Swanepoel",
    "creator": "Herman Swanepoel",
    "architect": "Herman Swanepoel",
    "copyright": "©2025 Herman Swanepoel. All Rights Reserved.",
    "license": "Proprietary",
    "repository": "IDE-Extension-for-local-AI-Agents"
  },
  "documentation.attribution": {
    "enabled": true,
    "author": "Herman Swanepoel",
    "autoSign": true,
    "templates": {
      "header": "/**\\n * @project AuraIA - Enterprise AI Agents Integration\\n * @author Herman Swanepoel\\n * @created {date}\\n * @copyright ©2025 Herman Swanepoel\\n */",
      "markdown": "---\\nauthor: Herman Swanepoel\\nproject: AuraIA Enterprise AI Agents Integration\\ncreated: {date}\\nupdated: {date}\\ncopyright: ©2025 Herman Swanepoel\\n---",
      "python": "\"\"\"\\nProject: AuraIA - Enterprise AI Agents Integration\\nAuthor: Herman Swanepoel\\nCreated: {date}\\nCopyright: ©2025 Herman Swanepoel\\n\"\"\""
    }
  },
  "git.defaultCommitMessage": "feat: ${input} | Author: Herman Swanepoel",
  "files.associations": {
    "*.kiro.hook": "json",
    ".kiro/steering/*.md": "markdown",
    ".kiro/hooks/*.md": "markdown"
  },
  "files.readonlyInclude": {
    ".kiro/steering/OMNIDEVGOD.md": true,
    ".kiro/steering/UNIFIED_MASTER_FRAMEWORK_v3.md": true
  },
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "on",
      "strings": "on",
      "other": "on"
    }
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "python.analysis.diagnosticMode": "workspace",

  // Additional editor settings for code quality
  "editor.rulers": [100],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "trunk.backgroundServices.enabled": false,
  "playwright.experimental.attachToPlaywright": false,
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "**/logs/**": true
  },
    "docker.host": "npipe:////./pipe/dockerDesktopEngine",
  "docker.context": "default",
  "docker.defaultContextPath": "${workspaceFolder}",
  "docker.containers.label": "com.docker.compose.project=${workspaceFolderBasename}",

  "dev.containers.dockerPath": "docker",
  "dev.containers.dockerComposePath": "docker-compose",
  "dev.containers.dockerSocketPath": "npipe:////./pipe/dockerDesktopEngine",
  "dev.containers.executeInWSL": false
}
