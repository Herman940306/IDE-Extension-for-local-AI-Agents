      "label": "Backend: Stop Agents (pid files)",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile","-Command","Get-ChildItem -Path '${workspaceFolder}/backend/.pids' -Filter 'agent-*.pid' -ErrorAction SilentlyContinue | ForEach-Object { try { $pid = [int](Get-Content $_.FullName); Stop-Process -Id $pid -Force -ErrorAction Stop; Remove-Item $_.FullName -Force; Write-Host ('Stopped PID {0}' -f $pid) } catch { Write-Host ('Skip/Fail PID file {0}: {1}' -f $_.Name,$_.Exception.Message) } }"],
