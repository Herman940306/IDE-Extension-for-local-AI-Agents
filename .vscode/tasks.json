    {
      "label": "Backend: Stop APIs (8001-8003)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-Command",
        "$ErrorActionPreference='SilentlyContinue'; foreach ($p in 8001,8002,8003) { $conns = Get-NetTCPConnection -LocalPort $p -State Listen; if ($conns) { $pids = $conns | Select-Object -ExpandProperty OwningProcess -Unique; foreach ($pid in $pids) { Stop-Process -Id $pid -Force; Write-Host ('Stopped PID {0} on port {1}' -f $pid,$p) } } }"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
