{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Python: Run Tests",
            "type": "shell",
            "command": "pytest",
            "args": [
                "backend/tests",
                "-v"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Python: Format with Black",
            "type": "shell",
            "command": "black",
            "args": [
                "backend",
                "--line-length=100"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Python: Lint with Flake8",
            "type": "shell",
            "command": "flake8",
            "args": [
                "backend"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Python: Install Dependencies",
            "type": "shell",
            "command": "pip",
            "args": [
                "install",
                "-r",
                "backend/requirements.txt"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
